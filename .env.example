VITE_PB_URL=http://127.0.0.1:8090

# Hanya tersedia bagi endpoint SvelteKit di server. Pada production, simpan
# seluruh nilai ini sebagai secret Cloudflare Pages, bukan variable VITE_.
PB_URL=http://127.0.0.1:8090

# Kartu akun demo hanya untuk pengembangan lokal. Aktifkan keduanya bersamaan.
VITE_ENABLE_DEMO_LOGIN=0
PB_REQUIRE_STAFF_SSO=0

# Hanya dibaca script Node `npm run pb:seed`; jangan memakai prefix VITE_.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Seeder demo hanya boleh digunakan pada PocketBase lokal atau test sementara.
APP_ENV=development
ALLOW_DEMO_SEED=0
