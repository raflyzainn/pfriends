{
	"name": "pfriends",
	"description": "Pfriends — Microsite Community Connect Initiative, Corporate Secretary Pertamina Foundation",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"pb:serve": "node scripts/pocketbase/serve.mjs",
		"pb:seed": "node scripts/pocketbase/seed-demo.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"verify:compile": "node scripts/verify/compile-all.mjs",
		"verify:domain": "node scripts/verify/domain-test.mjs",
		"verify:seed": "node scripts/verify/seed-test.mjs",
		"verify:purity": "node scripts/verify/public-purity.mjs",
		"verify:public": "npm run verify:purity",
		"verify": "npm run verify:compile && npm run verify:domain && npm run verify:seed && npm run verify:purity && npm run build",
		"verify:e2e": "node scripts/verify/e2e-routes.mjs",
		"verify:gamification": "node scripts/verify/e2e-gamification.mjs",
		"verify:pocketbase": "node scripts/verify/pocketbase-test.mjs",
		"verify:registration": "node scripts/verify/registration-test.mjs",
		"verify:directory": "node scripts/verify/directory-test.mjs",
		"verify:rewards": "node scripts/verify/reward-test.mjs",
		"verify:calendar": "node scripts/verify/calendar-test.mjs",
		"verify:backend": "npm run verify:pocketbase && npm run verify:registration && npm run verify:directory && npm run verify:rewards && npm run verify:calendar",
		"verify:browser": "npm run verify:e2e && npm run verify:gamification",
		"screenshot": "node scripts/verify/screenshot.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"svelte": "^5.45.6",
		"tailwindcss": "^4.1.17",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"dexie": "^4.3.0",
		"echarts": "^6.0.0",
		"pocketbase": "0.27.3"
	}
}
